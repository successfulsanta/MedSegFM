{
  "seed": 42,
  "deterministic": true,
  "device": "auto",
  "data": {
    "root_dir": "preprocessed",
    "label_map_path": "baseline_seg/label_map_example.json",
    "num_workers": 2,
    "cache_rate": 0.0
  },
  "model": {
    "backbone": "unet",
    "in_channels": 1,
    "num_classes": 16,
    "roi_size": [96, 96, 96],
    "channels": [16, 32, 64, 128, 256],
    "strides": [2, 2, 2, 2]
  },
  "train": {
    "batch_size": 1,
    "num_samples_per_volume": 1,
    "max_epochs": 200,
    "val_interval": 1,
    "early_stopping_patience": 25,
    "lr": 0.0001,
    "weight_decay": 0.00001,
    "amp": true
  },
  "augment": {
    "flip_prob": 0.5,
    "rotate_prob": 0.15,
    "scale_prob": 0.15,
    "noise_prob": 0.1
  },
  "loss": {
    "dice_weight": 1.0,
    "ce_weight": 1.0
  },
  "infer": {
    "sw_batch_size": 1,
    "overlap": 0.5,
    "min_component_size": 30
  },
  "logging": {
    "output_dir": "experiments",
    "experiment_name": "amos_lowmem_unet"
  }
}
